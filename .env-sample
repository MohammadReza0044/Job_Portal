# ============================================================
# Django
# ============================================================

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Shared secret for internal service-to-service requests.
# Generate a long, random value. Keep it identical across services.
INTERNAL_SERVICE_TOKEN=


# ============================================================
# Internal service URLs (Docker Compose network)
# ============================================================

JOB_SERVICE_URL=http://job-service:8000
APPLICATION_SERVICE_URL=http://application-service:8002
MATCHING_SERVICE_URL=http://matching-service:8003


# ============================================================
# Celery / Redis
# ============================================================

# Use the Redis Compose service name as the hostname.
CELERY_BROKER_URL=redis://redis:6379/0


# ============================================================
# PostgreSQL
# ============================================================

DATABASE_ENGINE=postgresql
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# ============================================================
# Service databases
# ============================================================

USER_DB_NAME=user_db
JOB_DB_NAME=job_db
APPLICATION_DB_NAME=application_db
MATCHING_DB_NAME=matching_db